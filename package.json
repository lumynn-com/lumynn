    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@fastify/static": "latest",
    "@floating-ui/dom": "^1.7.6",
    "@marktext/file-icons": "^1.0.6",
    "bcryptjs": "latest",
    "dompurify": "^3.4.6",
    "execall": "^3.0.0",
    "fast-diff": "^1.3.0",
    "fastify": "latest",
    "fuse.js": "^7.3.0",
    "fuzzysort": "^3.1.0",
    "gray-matter": "latest",
    "highlight.js": "^11.11.1",
    "html-tags": "^5.1.0",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "katex": "^0.16.45",
    "marked": "latest",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "ot-json1": "^1.0.2",
    "ot-text-unicode": "^4.0.0",
    "plantuml-encoder": "^1.4.0",
    "prismjs": "^1.30.0",
    "react": "latest",
    "react-dom": "latest",
    "rxjs": "^7.8.2",
    "sanitize-html": "latest",
    "snabbdom": "^3.6.3",
    "snabbdom-to-html": "^7.1.0",
    "turndown": "^7.2.4",
